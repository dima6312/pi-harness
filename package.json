{
	"name": "pi-harness",
	"version": "5.10.0",
	"private": true,
	"description": "The Pi extensions adeildo runs Pi with: one package with everything, and each piece on its own.",
	"license": "MIT",
	"author": {
		"name": "adeildo",
		"email": "contato@felipeadeildo.com",
		"url": "https://github.com/felipeadeildo"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/felipeadeildo/pi-harness.git"
	},
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"check": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"test": "bun test",
		"perf": "bun test packages/*/test/perf.test.ts",
		"bench:typing": "bun scripts/bench/typing.ts",
		"tasks:eval": "bun packages/tasks/eval/run.ts",
		"verify": "bun run check && bun run lint && bun run fmt:check && bun run test && bun run docs:check && bun run pi:defaults",
		"docs": "bun scripts/docs/index.ts",
		"docs:check": "bun scripts/docs/index.ts --check",
		"pi:defaults": "bun scripts/pi-defaults.ts",
		"smoke": "bun scripts/smoke.ts",
		"publish:dry": "bun scripts/publish.ts --dry-run",
		"publish": "bun scripts/publish.ts",
		"trust": "bun scripts/setup-npm-trust.ts",
		"peers:live": "bun packages/peers/eval/live.ts"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.2.0",
		"@earendil-works/pi-coding-agent": "1.2.0",
		"@earendil-works/pi-tui": "1.2.0",
		"@types/bun": "latest",
		"@types/node": "^22.10.0",
		"lefthook": "^2.1.14",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"typescript": "^5.7.0"
	},
	"trustedDependencies": [
		"lefthook"
	]
}
