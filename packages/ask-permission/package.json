{
	"name": "@adeildo/pi-ask-permission",
	"version": "5.6.0",
	"description": "A permission dialog for the Pi coding agent. Approve, always approve, or deny a tool call, and attach a note the model reads with the result.",
	"keywords": [
		"approval",
		"permission",
		"permissions",
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-package"
	],
	"homepage": "https://pi.dev/packages/@adeildo/pi-ask-permission",
	"bugs": "https://github.com/felipeadeildo/pi-harness/issues",
	"license": "MIT",
	"author": {
		"name": "adeildo",
		"email": "contato@felipeadeildo.com",
		"url": "https://github.com/felipeadeildo"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/felipeadeildo/pi-harness.git",
		"directory": "packages/ask-permission"
	},
	"files": [
		"src",
		"assets/preview.png",
		"README.md",
		"CONTRIBUTING.md",
		"LICENSE"
	],
	"type": "module",
	"imports": {
		"#core/*": "./src/core/*",
		"#identity": "./src/identity.ts",
		"#pi/*": "./src/pi/*",
		"#ui/*": "./src/ui/*",
		"#util/*": "./src/util/*"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepublishOnly": "cd ../.. && bun run verify"
	},
	"dependencies": {
		"@adeildo/pi-ask-questions": "workspace:*",
		"@adeildo/pi-kit": "workspace:*",
		"shell-quote": "^1.10.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"image": "https://raw.githubusercontent.com/felipeadeildo/pi-harness/main/packages/ask-permission/assets/preview.png"
	}
}
