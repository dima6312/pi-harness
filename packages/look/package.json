{
	"name": "@adeildo/pi-look",
	"version": "5.6.0",
	"description": "Pi's start screen, a framed editor and the footer, redrawn around the data that matters and painted only with the theme's colours.",
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-package",
		"statusline",
		"theme",
		"tui"
	],
	"homepage": "https://github.com/felipeadeildo/pi-harness/tree/main/packages/look#readme",
	"bugs": "https://github.com/felipeadeildo/pi-harness/issues",
	"license": "MIT",
	"author": {
		"name": "adeildo",
		"email": "contato@felipeadeildo.com",
		"url": "https://github.com/felipeadeildo"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/felipeadeildo/pi-harness.git",
		"directory": "packages/look"
	},
	"files": [
		"src",
		"assets/preview.png",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@adeildo/pi-kit": "workspace:*"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"image": "https://raw.githubusercontent.com/felipeadeildo/pi-harness/main/packages/look/assets/preview.png"
	}
}
