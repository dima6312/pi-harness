	"keywords": [
		"collaboration",
		"multi-agent",
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-package"
	],
	"homepage": "https://github.com/felipeadeildo/pi-harness/tree/main/packages/peers#readme",
	"bugs": "https://github.com/felipeadeildo/pi-harness/issues",
	"license": "MIT",
	"author": {
		"name": "adeildo",
		"email": "contato@felipeadeildo.com",
		"url": "https://github.com/felipeadeildo"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/felipeadeildo/pi-harness.git",
		"directory": "packages/peers"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
